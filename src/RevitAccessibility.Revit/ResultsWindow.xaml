<Window x:Class="RevitAccessibility.Revit.ResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Accessibility Pre-Check" Width="980" Height="620" MinWidth="700" MinHeight="400"
        ShowInTaskbar="False">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="UnverifiedBanner" Grid.Row="0" Background="#FFF4CE" BorderBrush="#C19C00" BorderThickness="1"
                Padding="8" Margin="0,0,0,6" Visibility="Collapsed">
            <TextBlock x:Name="UnverifiedText" TextWrapping="Wrap" FontWeight="SemiBold"
                       AutomationProperties.Name="Unverified values warning"/>
        </Border>

        <TextBlock x:Name="SummaryText" Grid.Row="1" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"
                   AutomationProperties.Name="Summary"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Level:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox x:Name="LevelFilter" Width="130" SelectionChanged="OnFilterChanged" AutomationProperties.Name="Level filter"/>
            <TextBlock Text="Status:" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <ComboBox x:Name="StatusFilter" Width="130" SelectionChanged="OnFilterChanged" AutomationProperties.Name="Status filter"/>
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <TextBox x:Name="SearchBox" Width="160" TextChanged="OnFilterChanged" AutomationProperties.Name="Search"/>
            <CheckBox x:Name="ShowPassed" Content="Show passed" IsChecked="False" VerticalAlignment="Center" Margin="12,0,0,0"
                      Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
            <Button Content="Select in model" Margin="16,0,0,0" Padding="8,2" Click="OnSelectInModel"/>
            <Button Content="Export CSV" Margin="6,0,0,0" Padding="8,2" Click="OnExportCsv"/>
        </StackPanel>

        <DataGrid x:Name="Grid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  SelectionChanged="OnRowSelected" MouseDoubleClick="OnSelectInModel" AutomationProperties.Name="Findings">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="130"/>
                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="70"/>
                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="90"/>
                <DataGridTextColumn Header="Mark" Binding="{Binding Mark}" Width="80"/>
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBox x:Name="Detail" Grid.Row="4" Height="90" IsReadOnly="True" TextWrapping="Wrap" Margin="0,6,0,0"
                 VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Detail"/>

        <TextBlock x:Name="Footer" Grid.Row="5" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,6,0,0"
                   AutomationProperties.Name="Disclaimer"/>
    </Grid>
</Window>
